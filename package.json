{
  "name": "pokemon-card-tracker",
  "version": "1.0.0",
  "description": "寶可夢卡牌價格追蹤器 - monorepo (npm workspaces)",
  "private": true,
  "license": "ISC",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @pct/api",
    "dev:web": "npm run dev -w @pct/web",
    "build:web": "npm run build -w @pct/web",
    "db:generate": "prisma generate --schema=packages/db/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=packages/db/prisma/schema.prisma",
    "db:reset": "prisma migrate reset --schema=packages/db/prisma/schema.prisma",
    "db:seed": "node packages/db/prisma/seed.js",
    "db:seed:admin": "node packages/db/prisma/seedAdmin.js",
    "db:seed:clear": "node packages/db/prisma/seedClear.js",
    "db:studio": "prisma studio --schema=packages/db/prisma/schema.prisma",
    "job:once": "npm run job:once -w @pct/api",
    "seed:real-sources": "node apps/api/src/scripts/seedRealSources.js",
    "test": "npm run test:api",
    "test:api": "npm run test -w @pct/api",
    "test:cov": "npm run test:cov -w @pct/api",
    "currency:once": "npm run currency:once -w @pct/api",
    "postinstall": "prisma generate --schema=packages/db/prisma/schema.prisma"
  },
  "devDependencies": {
    "prisma": "^6.5.0"
  },
  "engines": {
    "node": ">=20"
  }
}
