# ── 後端 / 資料庫共用環境變數 ──
# 複製本檔為 .env 後填入實際值：cp .env.example .env

# PostgreSQL 連線字串
# 若用本專案附的 docker-compose，預設帳密如下
DATABASE_URL="postgresql://pct:pct_password@localhost:5432/pokemon_card_tracker?schema=public"
DIRECT_URL=""

# API server
PORT=3000
# 允許的前端來源（CORS），多個用逗號分隔
CORS_ORIGIN="http://localhost:5173"

# JWT 管理者登入用密鑰（請改成隨機長字串）
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# 排程：每日自動抓價的 cron 時間（預設每天 02:00）
PRICE_SYNC_CRON="0 2 * * *"
# 設為 false 可在開發時關閉自動排程（仍可手動觸發）
ENABLE_CRON=true

# 單一來源抓取 timeout（毫秒）
FETCH_TIMEOUT_MS=10000
