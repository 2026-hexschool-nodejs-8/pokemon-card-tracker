# ── 後端 / 資料庫共用環境變數 ──
# 複製本檔為 .env 後填入實際值：cp .env.example .env

# PostgreSQL 連線字串
# 若用本專案附的 docker-compose，預設帳密如下
# 如要連 supabase 請改 DATEBASE_URL 與 DIRECT_URL
DATABASE_URL="postgresql://pct:pct_password@localhost:5432/pokemon_card_tracker?schema=public"
DIRECT_URL=""

# 如要建立自己的帳密，請多設定以下變數的值
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# API server
PORT=3000
# 允許的前端來源（CORS），多個用逗號分隔
CORS_ORIGIN="http://localhost:5173"

# JWT 管理者登入用密鑰（請改成隨機長字串）
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# 排程：每日自動抓價的 cron 時間（預設每天 02:00）
PRICE_SYNC_CRON="0 2 * * *"
# 設為 false 可在開發時關閉自動排程（仍可手動觸發）
ENABLE_CRON=true

# API 文件（Swagger UI）：設為 true 才掛 /docs 與 /docs.json；正式環境請維持關閉或不要設定
ENABLE_API_DOCS=true

# 單一來源抓取 timeout（毫秒）
FETCH_TIMEOUT_MS=10000

# TCGDEX API
TCGDEX_API_KEY="YOUR_TCGDEX_API_KEY"  # 從 https://dev.pokemontcg.io/ 申請

# ── 匯率同步 ──
# 匯率 API 端點（選填，預設 open.er-api.com，免金鑰）
# ⚠️ 僅供替換「同格式」端點（如測試用 mock server）：解析邏輯綁定 er-api 回傳格式
#    （rates / base_code / time_last_update_unix），換匯率供應商需另寫 adapter。
#    程式會驗證回應的 base_code=TWD，基準幣不符會直接報錯、不寫入。
# EXCHANGE_RATE_API_URL="https://open.er-api.com/v6/latest"
# 匯率 API timeout（毫秒，預設 10000）
# EXCHANGE_RATE_TIMEOUT_MS=10000
# 每日自動更新匯率的 cron 時間（預設每天 01:00，早於 02:00 抓價）
# CURRENCY_SYNC_CRON="0 1 * * *"
